<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="3.1 - Final summary and result">
<stringProp name="TestPlan.comments">Writes the FINAL version of the summary and fails if the result is KO (lost messages threshold LOSS_THRESHOLD_PCT).</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Final summary: rewrites the file with the result and fails this sample if the result is KO.
def render = props.get(&quot;PT_RENDER&quot;)
if (render == null) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;Counters not initialized (setUp 0.5 not executed)&quot;)
    return
}
props.put(&quot;PT_FINAL&quot;, &quot;true&quot;)
def res = render.call(true)
String text = res[0]
boolean esitoOk = res[1]
log.info(&quot;\n&quot; + text)
SampleResult.setResponseData(text, &quot;UTF-8&quot;)
SampleResult.setResponseMessage(esitoOk ? &quot;Result OK&quot; : &quot;Result KO&quot;)
SampleResult.setSuccessful(esitoOk)</stringProp>
</JSR223Sampler>
