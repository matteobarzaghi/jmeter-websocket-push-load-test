<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="1.2.4.1 - Build command payload + register command waiting for WAKE">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import groovy.json.JsonOutput
import java.util.concurrent.ConcurrentLinkedDeque

// Builds the payload for the sendCommand POST (sample command DISPLAY_INPUT_PROMPT).
String terminalId = vars.get(&quot;terminalId&quot;)
String feId = UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 14)
long sentAt = System.currentTimeMillis()
String validityStart = new Date(sentAt).format(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;, TimeZone.getTimeZone(&quot;UTC&quot;))
String validityEnd = new Date(sentAt + 5 * 60 * 1000).format(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;, TimeZone.getTimeZone(&quot;UTC&quot;))

def innerData = [
    data: [
        prompt: [
            terminalId: terminalId,
            registerId: &quot;00000001&quot;,
            title     : &quot;ENTER AMOUNT&quot;,
            text      : &quot;PLEASE ENTER THE AMOUNT&quot;,
            inputType : 2,
            timeout   : 60,
            confirm   : true
        ],
        modal: [
            title  : &quot;AMOUNT&quot;,
            type   : &quot;num_pad&quot;,
            onInput: true,
            unshift: true
        ]
    ],
    from       : terminalId,
    to         : terminalId,
    commandName: &quot;DISPLAY_INPUT_PROMPT&quot;,
    feId       : feId
]

def outerPayload = [
    commandId        : &quot;1&quot;,
    parameters        : [[name: &quot;data&quot;, type: &quot;text&quot;, value: JsonOutput.toJson(innerData)]],
    terminalId        : (terminalId as Integer),
    validityStartDate : validityStart,
    validityEndDate   : validityEnd
]

String body = JsonOutput.toJson(outerPayload)
vars.put(&quot;commandPayload&quot;, body)

// Registers the command as &quot;waiting for WAKE&quot; BEFORE sending: the WAKE can reach
// the terminal even before the POST gets its response. Removed in 1.2.4.2 if the POST fails.
def Q = props.get(&quot;PT_PENDING&quot;)
if (Q != null) {
    long[] entry = [System.currentTimeMillis(), 0L] as long[]
    Q.computeIfAbsent(terminalId, { new ConcurrentLinkedDeque&lt;long[]&gt;() } as java.util.function.Function).addLast(entry)
    vars.putObject(&quot;ptEntry&quot;, entry)
}

log.debug(&quot;sendCommand -&gt; terminalId=&quot; + terminalId + &quot; feId=&quot; + feId)</stringProp>
</JSR223PreProcessor>
<hashTree/>
<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="1.2.4.2 - Check 2xx + result_code 00">
<stringProp name="TestPlan.comments">POST OK only with 2xx and result_code 00 (searched at any level of the JSON); -JCHECK_RESULT_CODE=false to check only the 2xx.</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.atomic.AtomicLong

// Real outcome of the POST: 2xx + result_code &quot;00&quot; (searched at any level of the JSON).
// Updates the command counters; if the POST fails the command is no longer &quot;waiting for WAKE&quot;.
def S = props.get(&quot;PT_STATS&quot;)
def C = props.get(&quot;PT_CTRL&quot;)
def Q = props.get(&quot;PT_PENDING&quot;)

def findKey
findKey = { obj, String key -&gt;
    if (obj instanceof Map) {
        if (obj.containsKey(key)) { return obj.get(key) }
        for (v in obj.values()) { def r = findKey(v, key); if (r != null) { return r } }
    } else if (obj instanceof List) {
        for (v in obj) { def r = findKey(v, key); if (r != null) { return r } }
    }
    return null
}

String code = prev.getResponseCode() ?: &quot;&quot;
String failure = null
if (!code.startsWith(&quot;2&quot;)) {
    failure = &quot;HTTP &quot; + code
} else if (C == null || (boolean) C.get(&quot;checkResultCode&quot;)) {
    def rc = null
    try { rc = findKey(new JsonSlurper().parseText(prev.getResponseDataAsString()), &quot;result_code&quot;) } catch (Exception ignored) { }
    if (rc == null) { failure = &quot;result_code missing from response&quot; }
    else if (rc.toString() != &quot;00&quot;) { failure = &quot;result_code=&quot; + rc }
}

if (S != null) {
    S.computeIfAbsent(failure == null ? &quot;cmd_sent_ok&quot; : &quot;cmd_sent_ko&quot;, { new AtomicLong() } as java.util.function.Function).incrementAndGet()
}
if (failure != null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;sendCommand not accepted: &quot; + failure)
    def entry = vars.getObject(&quot;ptEntry&quot;)
    def dq = Q?.get(vars.get(&quot;terminalId&quot;))
    if (entry != null &amp;&amp; dq != null &amp;&amp; !dq.remove(entry) &amp;&amp; entry[1] &gt; 0L &amp;&amp; S != null) {
        // WAKE already arrived (and matched) for a command the POST reports as failed:
        // move it from &quot;delivered&quot; to a dedicated counter.
        S.get(&quot;cmd_wake_on_failed_post&quot;).incrementAndGet()
        S.get(&quot;wake_matched&quot;).decrementAndGet()
        S.get(&quot;wake_latency_sum&quot;).addAndGet(-(entry[1] - 1L))
    }
}
vars.remove(&quot;ptEntry&quot;)</stringProp>
</JSR223Assertion>
