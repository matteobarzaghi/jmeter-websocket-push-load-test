<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="0.4 - Count terminals from CSV">
<stringProp name="TestPlan.comments">Number of terminals = non-empty lines of device_ids.csv (override with -JDEVICE_COUNT=N, never above the CSV line count).</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import org.apache.jmeter.services.FileServer

// Counts the non-empty lines of device_ids.csv: number of threads (terminals) of Thread Group 1.
def csvFile = new File(FileServer.getFileServer().getBaseDir(), &quot;device_ids.csv&quot;)
int count = csvFile.exists() ? csvFile.readLines().findAll { it.trim() }.size() : 0
props.put(&quot;DEVICE_COUNT_AUTO&quot;, String.valueOf(count))
if (count == 0) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;device_ids.csv missing or empty: test stopped&quot;)
    log.error(&quot;device_ids.csv missing or empty in &quot; + csvFile.getAbsolutePath())
} else {
    log.info(&quot;Terminals in device_ids.csv: &quot; + count)
}</stringProp>
</JSR223Sampler>
<hashTree/>
<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="0.5 - Initialize counters and parameters">
<stringProp name="TestPlan.comments">Shared counters, queue of commands waiting for WAKE and -J parameters: CMD_PER_TERMINAL, CMD_INTERVAL_MS, PING_INTERVAL_MS, WS_MIN_DURATION_SEC, WS_MAX_DURATION_SEC, WAKE_GRACE_SEC, MATCH_WINDOW_SEC, AUTH_TIMEOUT_MS, AUTH_STRICT, AUTH_OK_MATCH, WAKE_MATCH, WS_RECONNECT, RECONNECT_DELAY_MS, CHECK_RESULT_CODE, CMD_TERMINALS (how many terminals send commands: the last N started, default all), CMD_STEPS/CMD_STEP_SEC (stepped commands: terminals with commands split into CMD_STEPS groups, group g starts g*CMD_STEP_SEC later), LOSS_THRESHOLD_PCT (result OK if lost messages are below this percentage of sent commands, default 3.5).</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.atomic.AtomicLong
import org.apache.jmeter.services.FileServer

// Shared counters, queue of commands waiting for WAKE and parameters (all overridable with -J&lt;name&gt;=value).
long now = System.currentTimeMillis()

def S = new ConcurrentHashMap&lt;String, AtomicLong&gt;()
[&quot;ws_open_ok&quot;, &quot;ws_open_fail&quot;, &quot;ws_reconnect_attempt&quot;, &quot;ws_reconnect_ok&quot;, &quot;ws_reconnect_fail&quot;,
 &quot;auth_ok&quot;, &quot;auth_unconfirmed&quot;, &quot;auth_fail&quot;, &quot;ws_drop&quot;, &quot;ws_close_ok&quot;, &quot;ws_close_fail&quot;,
 &quot;ping_sent&quot;, &quot;pong_received&quot;, &quot;server_ping&quot;, &quot;pong_sent&quot;,
 &quot;wake_received&quot;, &quot;wake_matched&quot;, &quot;wake_unmatched&quot;, &quot;wake_latency_sum&quot;, &quot;wake_latency_max&quot;,
 &quot;cmd_sent_ok&quot;, &quot;cmd_sent_ko&quot;, &quot;cmd_wake_on_failed_post&quot;, &quot;cmd_expired&quot;].each { S.put(it, new AtomicLong()) }

def P = props
def p = { String name, String dflt -&gt; String v = P.getProperty(name); (v == null || v.trim().isEmpty()) ? dflt : v.trim() }

// Effective terminals: never more than the CSV lines (extra threads stop at end of file).
int csvCount = Integer.parseInt(p(&quot;DEVICE_COUNT_AUTO&quot;, &quot;0&quot;))
int deviceCount = Math.min(Integer.parseInt(p(&quot;DEVICE_COUNT&quot;, String.valueOf(csvCount))), csvCount)
int cmdPerTerminal = Integer.parseInt(p(&quot;CMD_PER_TERMINAL&quot;, &quot;5&quot;))
long cmdIntervalMs = Long.parseLong(p(&quot;CMD_INTERVAL_MS&quot;, &quot;60000&quot;))
// Terminals sending commands: the last CMD_TERMINALS started by the ramp-up (default all); the others only hold the connection.
int cmdTerminals = Math.min(Integer.parseInt(p(&quot;CMD_TERMINALS&quot;, String.valueOf(deviceCount))), deviceCount)
// Per-terminal durations, measured from its first connection (so independent of the ramp-up).
long minDurationSec = Long.parseLong(p(&quot;WS_MIN_DURATION_SEC&quot;, &quot;0&quot;))
long maxDurationSec = Long.parseLong(p(&quot;WS_MAX_DURATION_SEC&quot;,
        String.valueOf(Math.max((long) (cmdPerTerminal * cmdIntervalMs / 1000) + 900L, minDurationSec + 60L))))

def C = new ConcurrentHashMap&lt;String, Object&gt;()
C.put(&quot;cmdPerTerminal&quot;, cmdPerTerminal)
C.put(&quot;cmdTerminals&quot;, cmdTerminals)
C.put(&quot;cmdSteps&quot;, Math.max(1, Integer.parseInt(p(&quot;CMD_STEPS&quot;, &quot;1&quot;))))
C.put(&quot;cmdStepMs&quot;, Long.parseLong(p(&quot;CMD_STEP_SEC&quot;, &quot;0&quot;)) * 1000L)
// Two-plateau profile (active if CMD_RAMP1_SEC &gt; 0): linear ramp 0 -&gt; CMD_TERMINALS_L1 terminals,
// plateau CMD_HOLD1_SEC, linear ramp up to CMD_TERMINALS, plateau CMD_HOLD2_SEC; commands end at the same time for all.
// Time zero of the commands: end of the connection ramp-up + CMD_START_DELAY_SEC.
long pr1 = Long.parseLong(p(&quot;CMD_RAMP1_SEC&quot;, &quot;0&quot;)) * 1000L
long ph1 = Long.parseLong(p(&quot;CMD_HOLD1_SEC&quot;, &quot;0&quot;)) * 1000L
long pr2 = Long.parseLong(p(&quot;CMD_RAMP2_SEC&quot;, &quot;0&quot;)) * 1000L
long ph2 = Long.parseLong(p(&quot;CMD_HOLD2_SEC&quot;, &quot;0&quot;)) * 1000L
int pl1 = Math.min(Integer.parseInt(p(&quot;CMD_TERMINALS_L1&quot;, String.valueOf(cmdTerminals))), cmdTerminals)
boolean profile = pr1 &gt; 0L
C.put(&quot;cmdProfile&quot;, profile)
C.put(&quot;cmdAnchorTs&quot;, now + Long.parseLong(p(&quot;RAMPUP_SEC&quot;, &quot;1&quot;)) * 1000L + Long.parseLong(p(&quot;CMD_START_DELAY_SEC&quot;, &quot;60&quot;)) * 1000L)
long profEnd = pr1 + ph1 + pr2 + ph2
int stepsN = (int) C.get(&quot;cmdSteps&quot;)
long stepMs = (long) C.get(&quot;cmdStepMs&quot;)
// Returns [offset ms, number of commands] for the command terminal with index idx (0 = first started).
def cmdPlan = { int idx -&gt;
    if (!profile) { return [cmdTerminals &gt; 0 ? (long) ((idx * stepsN).intdiv(cmdTerminals)) * stepMs : 0L, cmdPerTerminal] }
    long off = idx &lt; pl1 ? (long) ((pr1 * idx).intdiv(Math.max(pl1, 1)))
            : pr1 + ph1 + (cmdTerminals &gt; pl1 ? (long) ((pr2 * (idx - pl1)).intdiv(cmdTerminals - pl1)) : 0L)
    return [off, (int) ((profEnd - off + cmdIntervalMs - 1).intdiv(cmdIntervalMs))]
}
C.put(&quot;cmdPlan&quot;, cmdPlan)
long cmdExpected = 0L
for (int i = 0; i &lt; cmdTerminals; i++) { cmdExpected += (int) cmdPlan.call(i)[1] }
C.put(&quot;cmdExpected&quot;, cmdExpected)
C.put(&quot;cmdIntervalMs&quot;, cmdIntervalMs)
C.put(&quot;minDurationMs&quot;, minDurationSec * 1000L)
C.put(&quot;maxDurationMs&quot;, maxDurationSec * 1000L)
C.put(&quot;pingIntervalMs&quot;, Long.parseLong(p(&quot;PING_INTERVAL_MS&quot;, &quot;25000&quot;)))
C.put(&quot;authTimeoutMs&quot;, Long.parseLong(p(&quot;AUTH_TIMEOUT_MS&quot;, &quot;10000&quot;)))
C.put(&quot;authStrict&quot;, Boolean.parseBoolean(p(&quot;AUTH_STRICT&quot;, &quot;false&quot;)))
C.put(&quot;authMatch&quot;, p(&quot;AUTH_OK_MATCH&quot;, &quot;AUTH_OK&quot;))
C.put(&quot;wakeMatch&quot;, p(&quot;WAKE_MATCH&quot;, &quot;\&quot;type\&quot;:\&quot;WAKE\&quot;&quot;))
C.put(&quot;graceMs&quot;, Long.parseLong(p(&quot;WAKE_GRACE_SEC&quot;, &quot;30&quot;)) * 1000L)
C.put(&quot;matchWindowMs&quot;, Long.parseLong(p(&quot;MATCH_WINDOW_SEC&quot;, &quot;300&quot;)) * 1000L)
C.put(&quot;reconnect&quot;, Boolean.parseBoolean(p(&quot;WS_RECONNECT&quot;, &quot;false&quot;)))
C.put(&quot;checkResultCode&quot;, Boolean.parseBoolean(p(&quot;CHECK_RESULT_CODE&quot;, &quot;true&quot;)))
// Acceptance criterion: result OK if lost messages (failed POSTs + not delivered) are below this % of sent commands.
double lossThresholdPct = Double.parseDouble(p(&quot;LOSS_THRESHOLD_PCT&quot;, &quot;3.5&quot;))
C.put(&quot;droppedTerminals&quot;, ConcurrentHashMap.newKeySet())
C.put(&quot;deviceCount&quot;, deviceCount)
C.put(&quot;testStartTs&quot;, now)
C.put(&quot;lastWriteTs&quot;, new AtomicLong())

def reportDir = new File(FileServer.getFileServer().getBaseDir(), &quot;results&quot;)
if (!reportDir.exists()) { reportDir.mkdirs() }
String reportPath = new File(reportDir, &quot;connection_summary_&quot; + new Date(now).format(&quot;yyyy-MM-dd_HH-mm-ss&quot;) + &quot;.txt&quot;).getAbsolutePath()

props.put(&quot;PT_STATS&quot;, S)
props.put(&quot;PT_PENDING&quot;, new ConcurrentHashMap&lt;String, Object&gt;())
props.put(&quot;PT_CTRL&quot;, C)
props.put(&quot;PT_FINAL&quot;, &quot;false&quot;)

// Single summary rendering function, used by the live listener (3) and by the final tearDown (3.1).
def render = { boolean finalRun -&gt;
    synchronized (C) {
        long t = System.currentTimeMillis()
        def v = { String k -&gt; S.get(k)?.get() ?: 0L }
        long pending = 0L
        P.get(&quot;PT_PENDING&quot;).values().each { pending += it.size() }
        long opened = v(&quot;ws_open_ok&quot;) + v(&quot;ws_reconnect_ok&quot;)
        long active = Math.max(0L, opened - v(&quot;ws_drop&quot;) - v(&quot;ws_close_ok&quot;) - v(&quot;ws_close_fail&quot;))
        long matched = v(&quot;wake_matched&quot;)
        long sent = v(&quot;cmd_sent_ok&quot;) + v(&quot;cmd_sent_ko&quot;)
        long expected = (long) C.get(&quot;cmdExpected&quot;)
        long notSent = Math.max(0L, expected - sent)
        long notDelivered = finalRun ? pending + v(&quot;cmd_expired&quot;) : v(&quot;cmd_expired&quot;)
        String avgLat = matched &gt; 0 ? String.valueOf((long) (v(&quot;wake_latency_sum&quot;) / matched)) : &quot;-&quot;
        String pct = v(&quot;cmd_sent_ok&quot;) &gt; 0 ? String.format(Locale.ROOT, &quot;%.2f%%&quot;, 100.0d * matched / v(&quot;cmd_sent_ok&quot;)) : &quot;-&quot;
        // Lost messages = failed POSTs + accepted commands not delivered, over the total commands sent.
        long lost = v(&quot;cmd_sent_ko&quot;) + notDelivered
        double lostPct = sent &gt; 0 ? 100.0d * lost / sent : 0.0d
        String lostPctS = sent &gt; 0 ? String.format(Locale.ROOT, &quot;%.2f%%&quot;, lostPct) : &quot;-&quot;
        String thrS = String.format(Locale.ROOT, &quot;%s%%&quot;, String.valueOf(lossThresholdPct))
        // Result (acceptance criterion): OK if lost messages are below LOSS_THRESHOLD_PCT.
        // With no commands sent (connections-only test): OK if no failed opens and no disconnections.
        boolean esitoOk = sent &gt; 0 ? lostPct &lt; lossThresholdPct
                : (v(&quot;ws_open_fail&quot;) == 0 &amp;&amp; v(&quot;ws_drop&quot;) == 0 &amp;&amp; v(&quot;auth_fail&quot;) == 0)
        def sb = new StringBuilder()
        sb &lt;&lt; &quot;Push Terminals System Summary - &quot; &lt;&lt; (finalRun ? &quot;FINAL&quot; : &quot;updated at runtime&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Test start time:                  &quot; &lt;&lt; new Date((long) C.get(&quot;testStartTs&quot;)).format(&quot;yyyy-MM-dd HH:mm:ss&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Last update:                      &quot; &lt;&lt; new Date(t).format(&quot;yyyy-MM-dd HH:mm:ss&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Test end time:                    &quot; &lt;&lt; (finalRun ? new Date(t).format(&quot;yyyy-MM-dd HH:mm:ss&quot;) : &quot;-&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;------------------------------------------------------------\n&quot;
        sb &lt;&lt; &quot;CONNECTIONS\n&quot;
        sb &lt;&lt; &quot;Expected terminals:               &quot; &lt;&lt; deviceCount &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Connections opened OK:            &quot; &lt;&lt; v(&quot;ws_open_ok&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Failed opens:                     &quot; &lt;&lt; v(&quot;ws_open_fail&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Currently active connections:     &quot; &lt;&lt; active &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;AUTH confirmed (AUTH_OK):         &quot; &lt;&lt; v(&quot;auth_ok&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;AUTH not confirmed in timeout:    &quot; &lt;&lt; v(&quot;auth_unconfirmed&quot;) &lt;&lt; (C.get(&quot;authStrict&quot;) ? &quot; (AUTH_STRICT: connection closed)&quot; : &quot; (connection kept)&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Unexpected disconnections:        &quot; &lt;&lt; v(&quot;ws_drop&quot;) &lt;&lt; &quot; (terminals involved: &quot; &lt;&lt; C.get(&quot;droppedTerminals&quot;).size() &lt;&lt; &quot;)\n&quot;
        sb &lt;&lt; &quot;Reconnects attempted/OK/failed:   &quot; &lt;&lt; v(&quot;ws_reconnect_attempt&quot;) &lt;&lt; &quot; / &quot; &lt;&lt; v(&quot;ws_reconnect_ok&quot;) &lt;&lt; &quot; / &quot; &lt;&lt; v(&quot;ws_reconnect_fail&quot;) &lt;&lt; (C.get(&quot;reconnect&quot;) ? &quot;&quot; : &quot; (WS_RECONNECT disabled)&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Regular closes (OK/failed):       &quot; &lt;&lt; v(&quot;ws_close_ok&quot;) &lt;&lt; &quot; / &quot; &lt;&lt; v(&quot;ws_close_fail&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;------------------------------------------------------------\n&quot;
        sb &lt;&lt; &quot;KEEPALIVE\n&quot;
        sb &lt;&lt; &quot;PING sent / PONG received:        &quot; &lt;&lt; v(&quot;ping_sent&quot;) &lt;&lt; &quot; / &quot; &lt;&lt; v(&quot;pong_received&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;PING from server / PONG replied:  &quot; &lt;&lt; v(&quot;server_ping&quot;) &lt;&lt; &quot; / &quot; &lt;&lt; v(&quot;pong_sent&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;------------------------------------------------------------\n&quot;
        sb &lt;&lt; &quot;COMMANDS / WAKE\n&quot;
        sb &lt;&lt; &quot;Expected commands:                &quot; &lt;&lt; expected &lt;&lt; &quot; (&quot; &lt;&lt; cmdTerminals &lt;&lt; &quot; terminals with commands&quot; &lt;&lt; (C.get(&quot;cmdProfile&quot;) ? &quot;, two-plateau profile&quot; : &quot; x &quot; + cmdPerTerminal) &lt;&lt; &quot;)\n&quot;
        sb &lt;&lt; &quot;POST sendCommand OK (2xx + 00):   &quot; &lt;&lt; v(&quot;cmd_sent_ok&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;POST sendCommand failed:          &quot; &lt;&lt; v(&quot;cmd_sent_ko&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;WAKE received:                    &quot; &lt;&lt; v(&quot;wake_received&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;  matched to a sent command:      &quot; &lt;&lt; matched &lt;&lt; &quot; (&quot; &lt;&lt; pct &lt;&lt; &quot; of OK commands)\n&quot;
        sb &lt;&lt; &quot;  for POSTs later marked failed:  &quot; &lt;&lt; v(&quot;cmd_wake_on_failed_post&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;  with no pending command:        &quot; &lt;&lt; v(&quot;wake_unmatched&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Commands waiting for WAKE:        &quot; &lt;&lt; pending &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Commands expired without WAKE:    &quot; &lt;&lt; v(&quot;cmd_expired&quot;) &lt;&lt; &quot; (after &quot; &lt;&lt; ((long) C.get(&quot;matchWindowMs&quot;) / 1000) &lt;&lt; &quot;s)\n&quot;
        sb &lt;&lt; &quot;Estimated POST-&gt;WAKE latency (ms): avg &quot; &lt;&lt; avgLat &lt;&lt; &quot; / max &quot; &lt;&lt; (matched &gt; 0 ? v(&quot;wake_latency_max&quot;) : &quot;-&quot;) &lt;&lt; &quot;\n&quot;
        sb &lt;&lt; &quot;Lost messages (POST KO + not delivered): &quot; &lt;&lt; lost &lt;&lt; &quot; of &quot; &lt;&lt; sent &lt;&lt; &quot; sent (&quot; &lt;&lt; lostPctS &lt;&lt; &quot;, OK threshold &lt; &quot; &lt;&lt; thrS &lt;&lt; &quot;)&quot; &lt;&lt; (finalRun ? &quot;&quot; : &quot; - at runtime, commands still pending are excluded&quot;) &lt;&lt; &quot;\n&quot;
        if (finalRun) {
            sb &lt;&lt; &quot;------------------------------------------------------------\n&quot;
            sb &lt;&lt; &quot;Commands NOT sent:                &quot; &lt;&lt; notSent &lt;&lt; &quot; (no connection or test interrupted)\n&quot;
            sb &lt;&lt; &quot;Commands NOT delivered:           &quot; &lt;&lt; notDelivered &lt;&lt; &quot;\n&quot;
            sb &lt;&lt; &quot;Result: &quot; &lt;&lt; (sent &gt; 0
                    ? (esitoOk ? &quot;OK&quot; : &quot;KO&quot;) + &quot; - lost messages &quot; + lostPctS + (esitoOk ? &quot; below&quot; : &quot; at or above&quot;) + &quot; the threshold of &quot; + thrS + &quot; (LOSS_THRESHOLD_PCT)&quot;
                    : (esitoOk ? &quot;OK - no commands sent, connections stable&quot; : &quot;KO - no commands sent, failed opens or disconnections&quot;)) &lt;&lt; &quot;\n&quot;
        }
        new File(reportPath).write(sb.toString(), &quot;UTF-8&quot;)
        C.get(&quot;lastWriteTs&quot;).set(t)
        return [sb.toString(), esitoOk]
    }
}
props.put(&quot;PT_RENDER&quot;, render)
render.call(false)

String info = &quot;Parameters: terminals=&quot; + deviceCount + &quot; terminals with commands=&quot; + cmdTerminals + &quot; steps=&quot; + C.get(&quot;cmdSteps&quot;) + &quot;x&quot; + ((long) C.get(&quot;cmdStepMs&quot;) / 1000) + &quot;s&quot; + &quot; profile=&quot; + (profile ? (pl1 + &quot;/&quot; + cmdTerminals + &quot; terminals, ramps/plateaus &quot; + pr1/1000 + &quot;/&quot; + ph1/1000 + &quot;/&quot; + pr2/1000 + &quot;/&quot; + ph2/1000 + &quot;s, expected commands &quot; + cmdExpected) : &quot;no&quot;) + &quot; commands/terminal=&quot; + cmdPerTerminal + &quot; interval=&quot; + cmdIntervalMs +
        &quot;ms per-terminal duration min/max=&quot; + minDurationSec + &quot;/&quot; + maxDurationSec + &quot;s ping=&quot; + C.get(&quot;pingIntervalMs&quot;) +
        &quot;ms reconnect=&quot; + C.get(&quot;reconnect&quot;) + &quot; AUTH_STRICT=&quot; + C.get(&quot;authStrict&quot;) + &quot; loss threshold=&quot; + lossThresholdPct + &quot;% report=&quot; + reportPath
log.info(info)
SampleResult.setResponseData(info, &quot;UTF-8&quot;)</stringProp>
</JSR223Sampler>
<hashTree/>
</hashTree>
