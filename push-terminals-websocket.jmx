<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="0.1 - Build Basic Auth header">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Builds the Authorization: Basic header from TEST_USER/TEST_PASSWORD.
String username = vars.get(&quot;TEST_USER&quot;) ?: &quot;&quot;
String password = vars.get(&quot;TEST_PASSWORD&quot;) ?: &quot;&quot;
vars.put(&quot;loginBasicAuthHeader&quot;, &quot;Basic &quot; + Base64.getEncoder().encodeToString((username + &quot;:&quot; + password).getBytes(&quot;UTF-8&quot;)))</stringProp>
</JSR223PreProcessor>
<hashTree/>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="0.3 - Extract JWT and refresh_token and store them as properties">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import groovy.json.JsonSlurper

// The response nests access_token/refresh_token under &quot;data&quot;.
// Without access_token the sample fails and the setUp stops the test (on_sample_error = stoptest).
String responseText = prev.getResponseDataAsString()
def token = null
def refresh = null
def expiresIn = null
try {
    def json = new JsonSlurper().parseText(responseText)
    def payload = (json instanceof Map &amp;&amp; json.data instanceof Map) ? json.data : json
    token = payload.access_token ?: payload.accessToken ?: payload.token ?: payload.jwt
    refresh = payload.refresh_token ?: payload.refreshToken
    expiresIn = payload.expires_in
} catch (Exception e) {
    log.error(&quot;access-token response is not valid JSON: &quot; + e.getMessage())
}

if (token == null) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;access_token missing from response: test stopped&quot;)
    log.error(&quot;Login failed: access_token missing (HTTP &quot; + prev.getResponseCode() + &quot;). Test stopped.&quot;)
    return
}
props.put(&quot;JWT_TOKEN&quot;, token.toString())
log.info(&quot;JWT obtained (valid for &quot; + (expiresIn ?: &quot;?&quot;) + &quot;s)&quot;)

if (refresh != null) {
    props.put(&quot;REFRESH_TOKEN&quot;, refresh.toString())
} else {
    log.warn(&quot;No refresh_token in response: the sendCommand refresh_token cookie will be empty&quot;)
}</stringProp>
</JSR223PostProcessor>
<hashTree/>
<ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Check login OK (2xx)">
<collectionProp name="Asserion.test_strings"><stringProp name="0">2\d\d</stringProp></collectionProp>
