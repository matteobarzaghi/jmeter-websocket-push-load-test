<JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="3 - Live summary (file updated at runtime)">
<stringProp name="TestPlan.comments">Rewrites results/connection_summary_&lt;start&gt;.txt at most once per second.</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Live summary to file (results/connection_summary_&lt;start&gt;.txt): at most one write per second.
def render = props.get(&quot;PT_RENDER&quot;)
def C = props.get(&quot;PT_CTRL&quot;)
if (render == null || C == null || props.get(&quot;PT_FINAL&quot;) == &quot;true&quot;) { return }
if (!prev.getSampleLabel().startsWith(&quot;1.&quot;)) { return }
def lastWrite = C.get(&quot;lastWriteTs&quot;)
long last = lastWrite.get()
long now = System.currentTimeMillis()
// compareAndSet: with many parallel threads only one update per second goes through.
if (now - last &lt; 1000L || !lastWrite.compareAndSet(last, now)) { return }
render.call(false)</stringProp>
</JSR223Listener>
