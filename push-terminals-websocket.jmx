<hashTree/>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="1.0 - Classify frames, schedule PING/commands, connection state">
<stringProp name="TestPlan.comments">Single control point: classifies frames, updates counters, matches WAKEs to commands and sets the controller variables (wsAlive, authWaiting, wsContinue, pingDue, pongDue, cmdDue, closeNeeded, drainMore, wsSession, reconnectPause, readTimeoutMs).</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">import java.util.concurrent.atomic.AtomicLong

// Single control point of the terminal: classifies every frame read, updates the counters
// and decides the next step (wait for AUTH_OK, continuous listening, PING, send command, drain, close, reconnect).
def S = props.get(&quot;PT_STATS&quot;)
def C = props.get(&quot;PT_CTRL&quot;)
def Q = props.get(&quot;PT_PENDING&quot;)
if (S == null || C == null || Q == null) {
    log.error(&quot;Counters not initialized: setUp sampler 0.5 was not executed&quot;)
    return
}
def inc = { String k, long d = 1L -&gt;
    S.computeIfAbsent(k, { new AtomicLong() } as java.util.function.Function).addAndGet(d)
}
def getL = { String k -&gt; Long.parseLong(vars.get(k) ?: &quot;0&quot;) }

String tid = vars.get(&quot;terminalId&quot;)
long now = System.currentTimeMillis()
String cls = sampler.getClass().getSimpleName()
boolean ok = prev.isSuccessful()
String phase = vars.get(&quot;wsPhase&quot;) ?: &quot;INIT&quot;
long pingInterval = (long) C.get(&quot;pingIntervalMs&quot;)
// Only the last CMD_TERMINALS threads started send commands; the others get 0 commands (connection only).
int cmdIdx = ctx.getThreadNum() - ((int) C.get(&quot;deviceCount&quot;) - (int) C.get(&quot;cmdTerminals&quot;))
def cmdPlanT = cmdIdx &gt;= 0 ? C.get(&quot;cmdPlan&quot;).call(cmdIdx) : null
int cmdPerTerminal = cmdPlanT == null ? 0 : (int) cmdPlanT[1]
long cmdInterval = (long) C.get(&quot;cmdIntervalMs&quot;)

vars.put(&quot;frameType&quot;, &quot;&quot;)
vars.put(&quot;wakeLatencyMs&quot;, &quot;&quot;)

def setAll = { Map m -&gt; m.each { k, v -&gt; vars.put(k, String.valueOf(v)) } }

// End of the terminal connection: WAKE_GRACE_SEC after its last command (at least WS_MIN_DURATION_SEC),
// in any case within WS_MAX_DURATION_SEC. Both durations start from its first connection.
def terminalEnd = {
    long first = getL(&quot;firstOpenTs&quot;)
    long hard = first + (long) C.get(&quot;maxDurationMs&quot;)
    if (getL(&quot;cmdSent&quot;) &lt; cmdPerTerminal) { return hard }
    long base = cmdPerTerminal &gt; 0 ? getL(&quot;lastCmdTs&quot;) : first
    return Math.min(hard, Math.max(first + (long) C.get(&quot;minDurationMs&quot;), base + (long) C.get(&quot;graceMs&quot;)))
}

def endSession = { boolean canRetry -&gt;
    boolean retry = canRetry &amp;&amp; (boolean) C.get(&quot;reconnect&quot;) &amp;&amp; now &lt; terminalEnd() - 5000L
    setAll(wsSession: retry, reconnectPause: retry)
}

def drop = { String reason -&gt;
    if (vars.get(&quot;wsAlive&quot;) == &quot;true&quot;) {
        inc(&quot;ws_drop&quot;)
        C.get(&quot;droppedTerminals&quot;).add(tid)
        log.warn(&quot;Connection lost: terminalId=&quot; + tid + &quot; phase=&quot; + phase + &quot; reason=&quot; + reason)
    }
    setAll(wsAlive: false, authWaiting: false, wsContinue: false, pingDue: false, pongDue: false, cmdDue: false,
           drainMore: false, closeNeeded: false, wsPhase: &quot;END&quot;)
    endSession(true)
}

def startDrain = {
    setAll(wsContinue: false, pingDue: false, pongDue: false, cmdDue: false, wsPhase: &quot;DRAIN&quot;,
           drainMore: true, drainCount: 0, closeNeeded: true)
    endSession(false)
}

// Recomputes the state of the listening loop (1.2): the read waits until the next PING or command.
def monitor = {
    if (vars.get(&quot;wsAlive&quot;) != &quot;true&quot;) { return }
    long end = terminalEnd()
    if (now &gt;= end) { startDrain(); return }
    long toPing = pingInterval - (now - getL(&quot;lastPingTs&quot;))
    boolean cmdPending = getL(&quot;cmdSent&quot;) &lt; cmdPerTerminal &amp;&amp; vars.get(&quot;nextCmdTs&quot;) != null
    long toCmd = cmdPending ? getL(&quot;nextCmdTs&quot;) - now : Long.MAX_VALUE
    setAll(pingDue: toPing &lt;= 250L, cmdDue: cmdPending &amp;&amp; toCmd &lt;= 250L, wsContinue: true, wsPhase: &quot;MON&quot;,
           readTimeoutMs: Math.max(250L, [toPing, toCmd, end - now].min()))
}

// AUTH completed (or not confirmed with AUTH_STRICT=false): keepalive starts and, on the first session, the command plan.
def authDone = {
    setAll(authWaiting: false, lastPingTs: now)
    if (vars.get(&quot;nextCmdTs&quot;) == null) {
        // Steps: terminals with commands are split into CMD_STEPS groups; group g starts g*CMD_STEP_SEC later.
        long offset = cmdPlanT == null ? 0L : (long) cmdPlanT[0]
        long first = (boolean) C.get(&quot;cmdProfile&quot;) ? Math.max((long) C.get(&quot;cmdAnchorTs&quot;) + offset, now + 1000L) : now + cmdInterval + offset
        vars.put(&quot;nextCmdTs&quot;, String.valueOf(first))
    }
    monitor()
}

// Records a WAKE and matches it (FIFO) to the oldest command still pending for the same terminal.
def onWake = {
    inc(&quot;wake_received&quot;)
    long ts = prev.getEndTime()
    def dq = Q.get(tid)
    long[] e = null
    if (dq != null) {
        long win = (long) C.get(&quot;matchWindowMs&quot;)
        while ((e = dq.pollFirst()) != null) {
            if (ts - e[0] &gt; win) { inc(&quot;cmd_expired&quot;); continue }
            break
        }
    }
    if (e == null) {
        inc(&quot;wake_unmatched&quot;)
        log.warn(&quot;WAKE with no pending command: terminalId=&quot; + tid)
        return
    }
    long lat = Math.max(0L, ts - e[0])
    e[1] = lat + 1L  // marked as delivered (used by 1.2.4.2 if the POST later turns out to have failed)
    inc(&quot;wake_matched&quot;)
    inc(&quot;wake_latency_sum&quot;, lat)
    S.get(&quot;wake_latency_max&quot;).accumulateAndGet(lat, { a, b -&gt; Math.max(a, b) } as java.util.function.LongBinaryOperator)
    vars.put(&quot;wakeLatencyMs&quot;, String.valueOf(lat))
}

// Classifies a received text frame; returns its type (&quot;&quot; if no frame within the timeout).
def classify = { String data -&gt;
    if (data == null || data.isEmpty()) { return &quot;&quot; }
    def m = (data =~ /&quot;type&quot;\s*:\s*&quot;([^&quot;]+)&quot;/)
    String type = m.find() ? m.group(1) : &quot;UNKNOWN&quot;
    vars.put(&quot;frameType&quot;, type)
    if (type == &quot;PONG&quot;) { inc(&quot;pong_received&quot;) }
    if (type == &quot;PING&quot;) { inc(&quot;server_ping&quot;); vars.put(&quot;pongDue&quot;, &quot;true&quot;) }
    if (data.contains((String) C.get(&quot;wakeMatch&quot;))) { onWake() }
    return type
}

switch (cls) {
    case &quot;OpenWebSocketSampler&quot;:
        int sess = Integer.parseInt(vars.get(&quot;wsSessions&quot;) ?: &quot;0&quot;) + 1
        vars.put(&quot;wsSessions&quot;, String.valueOf(sess))
        if (sess == 1) { vars.put(&quot;firstOpenTs&quot;, String.valueOf(now)) } else { inc(&quot;ws_reconnect_attempt&quot;) }
        setAll(wsContinue: false, pingDue: false, pongDue: false, cmdDue: false, drainMore: false, closeNeeded: false,
               wsSession: false, reconnectPause: false)
        if (ok) {
            inc(sess &gt; 1 ? &quot;ws_reconnect_ok&quot; : &quot;ws_open_ok&quot;)
            setAll(wsAlive: true, wsPhase: &quot;AUTH&quot;, authWaiting: true, authStartTs: now, lastPingTs: now)
        } else {
            inc(sess &gt; 1 ? &quot;ws_reconnect_fail&quot; : &quot;ws_open_fail&quot;)
            log.warn(&quot;WSS open failed: terminalId=&quot; + tid + &quot; - &quot; + prev.getResponseCode() + &quot; &quot; + prev.getResponseMessage())
            setAll(wsAlive: false, wsPhase: &quot;END&quot;, authWaiting: false)
            endSession(true)
        }
        break

    case &quot;SingleWriteWebSocketSampler&quot;:
        if (!ok) { drop(&quot;write failed: &quot; + prev.getResponseMessage()); break }
        String req = sampler.getPropertyAsString(&quot;requestData&quot;)
        if (phase == &quot;AUTH&quot;) {
            vars.put(&quot;authStartTs&quot;, String.valueOf(now))
        } else if (req.contains(&quot;\&quot;PING\&quot;&quot;)) {
            inc(&quot;ping_sent&quot;)
            vars.put(&quot;lastPingTs&quot;, String.valueOf(now))
            monitor()
        } else if (req.contains(&quot;\&quot;PONG\&quot;&quot;)) {
            inc(&quot;pong_sent&quot;)
            vars.put(&quot;pongDue&quot;, &quot;false&quot;)
            monitor()
        }
        break

    case &quot;HTTPSamplerProxy&quot;:
        // POST sendCommand: the outcome (2xx + result_code) is counted by 1.2.4.2; here only the scheduling.
        vars.put(&quot;cmdSent&quot;, String.valueOf(getL(&quot;cmdSent&quot;) + 1))
        vars.put(&quot;lastCmdTs&quot;, String.valueOf(now))
        long next = getL(&quot;nextCmdTs&quot;) + cmdInterval
        vars.put(&quot;nextCmdTs&quot;, String.valueOf(next &lt; now ? now + cmdInterval : next))
        vars.put(&quot;cmdDue&quot;, &quot;false&quot;)
        monitor()
        break

    case &quot;SingleReadWebSocketSampler&quot;:
        if (!ok) {
            vars.put(&quot;frameType&quot;, &quot;ERROR&quot;)
            drop(&quot;read failed: &quot; + prev.getResponseMessage())
            break
        }
        String data = prev.getResponseDataAsString()
        String type = classify(data)
        if (phase == &quot;AUTH&quot;) {
            // Log of frames received while waiting for AUTH_OK (only the first 20 of the test, to check the real format).
            if (type != &quot;&quot; &amp;&amp; C.computeIfAbsent(&quot;authFrameLogs&quot;, { new java.util.concurrent.atomic.AtomicInteger() } as java.util.function.Function).incrementAndGet() &lt;= 20) {
                log.info(&quot;Frame while waiting for AUTH_OK terminalId=&quot; + tid + &quot;: &quot; + data)
            }
            if (type != &quot;&quot; &amp;&amp; data.contains((String) C.get(&quot;authMatch&quot;))) {
                inc(&quot;auth_ok&quot;)
                authDone()
            } else if (now - getL(&quot;authStartTs&quot;) &gt;= (long) C.get(&quot;authTimeoutMs&quot;)) {
                inc(&quot;auth_unconfirmed&quot;)
                vars.put(&quot;authWaiting&quot;, &quot;false&quot;)
                if ((boolean) C.get(&quot;authStrict&quot;)) {
                    inc(&quot;auth_fail&quot;)
                    log.warn(&quot;AUTH_OK not received within timeout: terminalId=&quot; + tid + &quot; - closing (AUTH_STRICT=true)&quot;)
                    startDrain()
                } else {
                    log.warn(&quot;AUTH_OK not received within timeout: terminalId=&quot; + tid + &quot; - continuing (AUTH_STRICT=false)&quot;)
                    authDone()
                }
            }
        } else if (phase == &quot;DRAIN&quot;) {
            int dc = Integer.parseInt(vars.get(&quot;drainCount&quot;) ?: &quot;0&quot;) + 1
            vars.put(&quot;drainCount&quot;, String.valueOf(dc))
            if (type == &quot;&quot; || dc &gt;= 50) { vars.put(&quot;drainMore&quot;, &quot;false&quot;) }
        } else {
            monitor()
        }
        break

    case &quot;CloseWebSocketSampler&quot;:
        inc(ok ? &quot;ws_close_ok&quot; : &quot;ws_close_fail&quot;)
        if (!ok) { log.warn(&quot;Irregular close terminalId=&quot; + tid + &quot;: &quot; + prev.getResponseMessage()) }
        setAll(wsAlive: false, closeNeeded: false, drainMore: false, wsPhase: &quot;END&quot;, wsSession: false, reconnectPause: false)
        break
}</stringProp>
</JSR223PostProcessor>
<hashTree/>
