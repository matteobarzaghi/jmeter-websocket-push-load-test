# Copy to .env and fill in real values. .env is git-ignored.
# Plain KEY=value lines (Java properties format): JMeter loads this file directly with -q .env
# Any key can also be overridden on the command line with -J<KEY>=value.

# --- Target system ---
# Host for the WSS connection and the sendCommand POST
WS_HOST=push.example.com
# Host for the access-token login
TOKEN_HOST=push.example.com
WS_PORT=443
# Endpoint paths (login, WebSocket upgrade, sendCommand POST)
AUTH_PATH=/auth/token
WS_PATH=/ws
COMMAND_PATH=/commands
# Value of the X-Real-Host login header
REAL_HOST=api.example.com

# --- Login (secrets: never commit real values) ---
TEST_USER=test-user
TEST_PASSWORD=change-me
# Values of the X-Tenant-Id / X-Station-Id login headers
TENANT_ID=000000
STATION_ID=000000

# --- Load profile (optional, defaults shown) ---
# DEVICE_COUNT defaults to the number of lines in device_ids.csv
#DEVICE_COUNT=100
#RAMPUP_SEC=1
#CMD_PER_TERMINAL=5
#CMD_INTERVAL_MS=60000
#PING_INTERVAL_MS=25000
#LOSS_THRESHOLD_PCT=3.5
#WS_RECONNECT=false
